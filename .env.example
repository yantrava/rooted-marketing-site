# ====== Rooted marketing site — env template ======
# Copy this to `.env.local` and fill in real values.
# `.env.local` is gitignored; never commit it.

# Public site URL (used for canonical URLs, sitemap, OG cards)
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Supabase (Rooted production project) — public values, safe in client bundle
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service role (server-side only — used by /api/waitlist).
# Keep secret. Vercel: set in env vars, do not expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# PostHog (analytics) — public posthog project key, safe in client
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
